Name     SPISEQ ;
PartNo   U2 ;
Date     10/2026 ;
Revision 02 ;
Designer PH. ROEHR ;
Company  EC-6809 ;
Assembly SPI_PAR_LS166 ;
Location U2 ;
Device   g22v10 ;

/****************************************************************************/
/* EC-6809 / HD63C09 PARALLEL TO SPI INTERFACE                              */
/* U2 - SPI CLOCK SEQUENCER (SPI MODE 0, MSB FIRST), 299 CLOCK, INTERRUPT   */
/* REV 02: NO 74LS166. SRCLK CLOCKS THE SINGLE 74LS299.                     */
/* GAL22V10 / ATF22V10C                                                     */
/*                                                                          */
/* ALL PINS ARE DECLARED ACTIVE HIGH: EVERY EQUATION GIVES THE PIN LEVEL.   */
/* EXCEPT PIN 23, DECLARED !INTN: INTN = 1 IN THE EQUATIONS = PIN LOW.      */
/*                                                                          */
/* CLOCK = QN FROM U1 (Q FALLING, MID E HIGH), 2 MHZ AT E = 2 MHZ.          */
/* A WRITE TO DATA (LOAD HIGH AT THE CLOCK EDGE) SETS BUSY AND CLEARS THE   */
/* PHASE COUNTER P3 P2 P1 SCK. EACH TICK ADVANCES ONE HALF BIT; SCK = P0.   */
/* BUSY CLEARS ON THE TICK THAT ENDS PHASE 15 (8 SCK PULSES).               */
/*                                                                          */
/* SPEED (SPD1 SPD0 FROM U1)   TICK EVERY   SCK       E CYCLES PER BYTE     */
/*   00                        1 CLOCK      1 MHZ     16                    */
/*   01                        2 CLOCKS     500 KHZ   32                    */
/*   10                        4 CLOCKS     250 KHZ   64                    */
/*   11                        8 CLOCKS     125 KHZ   128 (FIRST HALF BIT   */
/*                                                    MAY BE 1 CLOCK SHORT) */
/*                                                                          */
/* INTN = TRANSFER COMPLETE (OPEN COLLECTOR, ACTIVE LOW). WITH IE = 1       */
/* (CTRL=D5) IT GOES LOW ON THE EDGE THAT ENDS THE BYTE (BUSY 1 -> 0).      */
/* RELEASED BY A READ OF DATA, A WRITE TO DATA, IE = 0 OR RESET.            */
/* SETTING IE ALONE DOES NOT INTERRUPT. READING STAT DOES NOT CLEAR IT.     */
/* RESET IS SYNCHRONOUS: SCK LOW, BUSY 0, IE 0, INTN RELEASED.              */
/*                                                                          */
/* I/O MAP                                                                  */
/* PIN NAME   DIR   CONNECTION         FUNCTION                             */
/*  1  QN     IN    U1.23 QN           REGISTER CLOCK                       */
/*  2  LOAD   IN    U1.15 LOAD         START, HIGH = WRITE DATA (299 S1)    */
/*  3  SELN   IN    J1.14 SELN         STATUS READ / CTRL WRITE DECODE      */
/*  4  A0     IN    J1.9  CPU A0                                            */
/*  5  RW     IN    J1.10 RW                                                */
/*  6  E      IN    J1.11 CPU E                                             */
/*  7  SPD0   IN    U1.16 SPD0         SPEED BIT 0                          */
/*  8  RSTN   IN    J1.13 RSTN         ACTIVE LOW                           */
/*  9  SPD1   IN    U1.22 SPD1         SPEED BIT 1                          */
/* 10  D5     IN    J1.6  D5           CTRL INTERRUPT ENABLE                */
/* 11  Q      IN    J1.12 CPU          Q        TX LOAD CLOCK TIMING        */
/* 12  GND                                                                  */
/* 13  T      IN    U1.14 T            CLOCK / 2 FOR 125 KHZ                */
/* 14  PS0    OUT   TP PS0             REG, PRESCALER BIT 0                 */
/* 15  PS1    OUT   TP PS1             REG, PRESCALER BIT 1                 */
/* 16  P1     OUT   TP P1              REG, PHASE BIT 1                     */
/* 17  P2     OUT   TP P2              REG, PHASE BIT 2                     */
/* 18  P3     OUT   TP P3              REG, PHASE BIT 3                     */
/* 19  SRCLK  OUT   U9.12 CP           299 CLOCK: LOAD EDGE, THEN SCK       */
/* 20  SCK    OUT   U4.12 CLK,         J2.3    REG, SPI CLOCK = PHASE BIT 0 */
/* 21  BUSY   I/O   J1.8  D7           REG, 3-STATE, DRIVES D7 ON STAT READ */
/* 22  IE     OUT   TP IE              REG, INTERRUPT ENABLE                */
/* 23  INTN   OUT   J1.17 INTN         REG, OPEN COLLECTOR, TO IRQN OR      */
/*                                     FIRQN, PULL-UP ON THE CPU BOARD      */
/* 24  VCC          VCC                                                     */
/****************************************************************************/

/* INPUTS */
PIN 1  = QN ;
PIN 2  = LOAD ;
PIN 3  = SELN ;
PIN 4  = A0 ;
PIN 5  = RW ;
PIN 6  = E ;
PIN 7  = SPD0 ;
PIN 8  = RSTN ;
PIN 9  = SPD1 ;
PIN 10 = D5 ;
PIN 11 = Q ;
PIN 13 = T ;

/* OUTPUTS */
PIN 14 = PS0 ;
PIN 15 = PS1 ;
PIN 16 = P1 ;
PIN 17 = P2 ;
PIN 18 = P3 ;
PIN 19 = SRCLK ;
PIN 20 = SCK ;
PIN 21 = BUSY ;
PIN 22 = IE ;
PIN 23 = !INTN ;                 /* ACTIVE LOW, SEE HEADER */

START = LOAD ;
RUN   = RSTN & !START ;

/* PRESCALER: COUNT ENABLE AND TICK PER SPEED                               */
CNT  = !SPD1 # !SPD0 # T ;
TICK = (!SPD1 & !SPD0)
     # (!SPD1 &  SPD0 & PS0)
     # ( SPD1 & !SPD0 & PS1 & PS0)
     # ( SPD1 &  SPD0 & PS1 & PS0 & T) ;
INC  = BUSY & TICK ;

PS0.d = RUN & BUSY & (PS0 $ CNT) ;
PS1.d = RUN & BUSY & (PS1 $ (CNT & PS0)) ;

/* PHASE COUNTER, SCK = BIT 0 */
SCK.d = RUN & (SCK $ INC) ;
P1.d  = RUN & (P1 $ (INC & SCK)) ;
P2.d  = RUN & (P2 $ (INC & SCK & P1)) ;
P3.d  = RUN & (P3 $ (INC & SCK & P1 & P2)) ;

/* 74LS299 CLOCK. S0 IS TIED HIGH, S1 IS LOAD.
   WHILE LOAD IS HIGH, SRCLK FOLLOWS !Q, SO IT RISES AT Q FALL AND THE 299
   PARALLEL-LOADS. OTHERWISE SRCLK IS SCK: MISO IS SAMPLED ON THE RISING
   EDGE AND Q7 (MOSI) CHANGES ONE CLOCK-TO-Q LATER. */
SRCLK = (LOAD & !Q) # (!LOAD & SCK) ;

/* BUSY: SET ON START, CLEAR AFTER PHASE 15. ON D7 FOR A STATUS READ ONLY.  */
BUSY.d  = RSTN & (START # (BUSY & !(INC & SCK & P1 & P2 & P3))) ;
BUSY.oe = !SELN & A0 & RW & E ;

/* INTERRUPT ENABLE = CTRL D5 */
WRCTL = !SELN & A0 & !RW ;
IE.d  = RSTN & ((WRCTL & D5) # (!WRCTL & IE)) ;

/* INTN: TRANSFER COMPLETE FLAG. SET WITH IE ON THE TICK THAT ENDS PHASE 15
   (SAME EDGE AS BUSY CLEARS), HELD UNTIL A READ OR WRITE OF DATA, IE = 0
   OR RESET. THE PIN IS DRIVEN (LOW) ONLY WHILE SET: OPEN COLLECTOR. */
RDDAT   = !SELN & !A0 & RW ;
INTN.d  = RUN & IE & ((INC & SCK & P1 & P2 & P3) # (INTN & !RDDAT)) ;
INTN.oe = INTN ;

/* GLOBAL ASYNC RESET AND SYNC PRESET (ONE TERM EACH, SHARED BY ALL
   REGISTERS OF THE 22V10). NOT USED: RESET IS SYNCHRONOUS VIA RSTN. */
PS0.ar = 'b'0 ;
PS0.sp = 'b'0 ;
PS1.ar = 'b'0 ;
PS1.sp = 'b'0 ;
SCK.ar = 'b'0 ;
SCK.sp = 'b'0 ;
P1.ar = 'b'0 ;
P1.sp = 'b'0 ;
P2.ar = 'b'0 ;
P2.sp = 'b'0 ;
P3.ar = 'b'0 ;
P3.sp = 'b'0 ;
BUSY.ar = 'b'0 ;
BUSY.sp = 'b'0 ;
IE.ar = 'b'0 ;
IE.sp = 'b'0 ;
INTN.ar = 'b'0 ;
INTN.sp = 'b'0 ;
